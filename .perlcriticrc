# Perl::Critic config for the privacyIDEA FreeRADIUS module.
# severity 4 = report severe + high-importance issues (lower = stricter). This is
# a meaningful gate for new code; the exclusions below are policies that fire
# ONLY on the module's pre-existing rlm_perl boilerplate, not on new logic.
severity = 4

# --- exclusions: each fires only on legacy/boilerplate, documented so a real
#     new-code violation of a still-enabled policy fails the gate. ---

# rlm_perl return codes are defined as `use constant RLM_MODULE_* => n;` (idiomatic
# for this module) — 18 hits, all the constant block.
[-ValuesAndExpressions::ProhibitConstantPragma]

# The module is loaded by rlm_perl into package main and has no `package` line.
[-Modules::RequireExplicitPackage]

# Upstream rlm_perl example subs (xlat/detach/log_request_attributes) don't end
# in an explicit return; new subs in this module do.
[-Subroutines::RequireFinalReturn]

# Legacy: module uses `use strict` but not `use warnings` at the top.
[-TestingAndDebugging::RequireUseWarnings]

# The following fire only on xlat(), verbatim upstream example code that loads and
# evals an external perl file.
[-InputOutput::ProhibitBarewordFileHandles]
[-InputOutput::ProhibitTwoArgOpen]
[-InputOutput::RequireBriefOpen]
[-BuiltinFunctions::ProhibitStringyEval]
